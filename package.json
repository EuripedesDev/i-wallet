{
	"name": "iwallet",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"dev": "pglite-server --db=./.pglite --port=5433 --max-connections=10 --include-database-url --run \"npm run dev:app\"",
		"dev:app": "drizzle-kit migrate && DB_POOL_MAX=1 next dev",
		"build": "next build",
		"start": "next start",
		"lint": "eslint",
		"db:server": "pglite-server --db=./.pglite --port=5433 --max-connections=10",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:studio": "drizzle-kit studio",
		"format": "prettier --write .",
		"format:check": "prettier --check ."
	},
	"dependencies": {
		"@vercel/blob": "^2.8.0",
		"bcryptjs": "^3.0.3",
		"drizzle-orm": "^0.45.3",
		"next": "16.3.6",
		"next-auth": "^5.0.0-beta.32",
		"postgres": "^3.4.9",
		"react": "19.2.8",
		"react-dom": "19.2.8",
		"server-only": "^0.0.1",
		"zod": "^4.6.5"
	},
	"devDependencies": {
		"@electric-sql/pglite-socket": "^0.2.11",
		"@tailwindcss/postcss": "^4",
		"@types/node": "^20",
		"@types/react": "^19",
		"@types/react-dom": "^19",
		"dotenv": "^18.0.3",
		"drizzle-kit": "^0.31.11",
		"eslint": "^9",
		"eslint-config-next": "16.3.6",
		"prettier": "^3.9.9",
		"prettier-plugin-organize-imports": "^4.3.0",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"tailwindcss": "^4",
		"typescript": "^5"
	}
}
